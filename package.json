{
  "name": "expo-rr7-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"core,web,expo\" \"pnpm --filter @monorepo/core dev\" \"pnpm --filter @monorepo/web dev\" \"pnpm --filter @monorepo/expo dev\"",
    "dev:expo": "concurrently -n \"core,expo\" \"pnpm --filter @monorepo/core dev\" \"pnpm --filter @monorepo/expo dev\"",
    "dev:web": "concurrently -n \"core,database,web\" \"pnpm --filter @monorepo/core dev\" \"pnpm --filter @monorepo/database dev\" \"pnpm --filter @monorepo/web dev\"",
    "build": "pnpm run --filter './packages/*' build && pnpm run --filter './apps/*' build",
    "build:expo": "pnpm --filter @monorepo/expo build",
    "build:web": "pnpm --filter @monorepo/web build",
    "build:packages": "pnpm run --filter './packages/*' build",
    "test": "pnpm run --recursive test",
    "test:web": "pnpm --filter @monorepo/web test",
    "test:expo": "pnpm --filter @monorepo/expo test",
    "test:packages": "pnpm --filter './packages/*' test",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm run --recursive lint",
    "type-check": "pnpm run --recursive type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm run --recursive clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @monorepo/database db:generate",
    "db:studio": "pnpm --filter @monorepo/database db:studio",
    "db:migrate:local": "pnpm --filter @monorepo/web d1:migrate:local",
    "db:migrate:remote": "pnpm --filter @monorepo/web d1:migrate:remote",
    "wrangler": "pnpm --filter @monorepo/web exec wrangler",
    "deploy:web": "pnpm --filter @monorepo/web deploy"
  },
  "devDependencies": {
    "@monorepo/config-eslint": "workspace:*",
    "@monorepo/config-prettier": "workspace:*",
    "@monorepo/config-typescript": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.1.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
