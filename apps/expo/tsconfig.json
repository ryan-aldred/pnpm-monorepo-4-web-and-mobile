{
  "extends": "@monorepo/config-typescript/native.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@monorepo/ui": ["../../packages/ui/src"],
      "@monorepo/core": ["../../packages/core/src"],
      "@monorepo/core/*": ["../../packages/core/src/*"],
      "@monorepo/types": ["../../packages/types/src"],
      "@monorepo/mocks/*": ["../../packages/mocks/src/*"],
      "@monorepo/i18n": ["../../packages/i18n/src"],
      "@monorepo/i18n/*": ["../../packages/i18n/src/*"]
    },
    "types": ["nativewind/types", "jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "nativewind-env.d.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
