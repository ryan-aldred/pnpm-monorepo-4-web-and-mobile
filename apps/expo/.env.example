# API URL for development (React Router 7 server)
# Use localhost for simulators/emulators
EXPO_PUBLIC_API_URL=http://localhost:5173

# For physical devices, use your computer's local IP
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5173

# Enable MSW mock server for offline development
# Set to "true" to use mocked API responses instead of the real server
# EXPO_PUBLIC_USE_MOCKS=true
