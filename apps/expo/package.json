    "@lingui/react": "^5.2.0",
    "@monorepo/core": "workspace:*",
    "@monorepo/i18n": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo-localization": "~16.0.0",
    "@monorepo/types": "workspace:*",
    "@monorepo/ui": "workspace:*",
    "better-auth": "^1.4.18",
    "expo": "~52.0.0",
    "expo-linking": "^8.0.11",
    "expo-router": "~4.0.0",
