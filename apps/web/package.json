{
  "name": "@monorepo/web",
  "version": "1.0.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf build node_modules .react-router"
  },
  "dependencies": {
    "@monorepo/core": "workspace:*",
    "@monorepo/types": "workspace:*",
    "@monorepo/ui": "workspace:*",
    "@react-router/node": "^7.0.0",
    "@react-router/serve": "^7.0.0",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@monorepo/config-eslint": "workspace:*",
    "@monorepo/config-testing": "workspace:*",
    "@monorepo/config-typescript": "workspace:*",
    "@monorepo/config-vitest": "workspace:*",
    "@react-router/dev": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
