{
  "name": "@monorepo/web",
  "version": "1.0.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf build node_modules .react-router",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/expo": "^1.4.18",
    "@monorepo/core": "workspace:*",
    "@monorepo/database": "workspace:*",
    "@monorepo/types": "workspace:*",
    "@monorepo/ui": "workspace:*",
    "@react-router/cloudflare": "^7.13.0",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@monorepo/config-eslint": "workspace:*",
    "@monorepo/config-testing": "workspace:*",
    "@monorepo/config-typescript": "workspace:*",
    "@monorepo/config-vitest": "workspace:*",
    "@react-router/dev": "^7.13.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "wrangler": "^3.91.0"
  }
}
