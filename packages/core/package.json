{
  "name": "@monorepo/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/api/index.d.mts",
      "import": "./dist/api/index.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.mts",
      "import": "./dist/hooks/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    },
    "./data": {
      "types": "./dist/data/index.d.mts",
      "import": "./dist/data/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@monorepo/types": "workspace:*",
    "react": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@monorepo/config-eslint": "workspace:*",
    "@monorepo/config-typescript": "workspace:*",
    "@types/react": "^18.3.0",
    "tsdown": "^0.17.3",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
